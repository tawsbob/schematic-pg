models {
  model Team {
    id:      UUID         @id @default(gen_random_uuid())
    name:    VARCHAR(100)

    members: TeamMember[]
    notes:   Note[]
    announcements: Announcement[]

    @rest(false)
  }

  model TeamMember {
    id:       UUID    @id @default(gen_random_uuid())
    teamId:   UUID
    userId:   UUID
    isActive: BOOLEAN @default(true)

    team: Team @relation(
      fields: [teamId],
      references: [id],
      onDelete: CASCADE
    )
    user: User @relation(
      fields: [userId],
      references: [id],
      onDelete: CASCADE
    )

    @rest(false)
    @@index(fields: [userId, teamId])
  }

  model Note {
    id:     UUID         @id @default(gen_random_uuid())
    teamId: UUID
    title:  VARCHAR(255)
    body:   TEXT

    team: Team @relation(
      fields: [teamId],
      references: [id],
      onDelete: CASCADE
    )

    @policy(
      role: USER,
      allow: [select, insert, update, delete],
      where: activeTeamMember
    )
    @policy(role: ADMIN, allow: all)
  }

  model Announcement {
    id:      UUID @id @default(gen_random_uuid())
    teamId:  UUID
    message: TEXT

    team: Team @relation(
      fields: [teamId],
      references: [id],
      onDelete: CASCADE
    )

    @policy(
      role: USER,
      allow: [select, update, delete],
      where: """
        EXISTS (
          SELECT 1
          FROM team_member tm
          WHERE tm.team_id = announcement.team_id
            AND tm.user_id = {{auth.user.id}}
            AND tm.is_active = true
        )
      """
    )
    @policy(role: ADMIN, allow: all)
  }
}
