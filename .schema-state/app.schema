extensions {

  pgcrypto { version: "1.3" }

  uuid-ossp

}

enums {

  OrderStatus { PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED }

  UserRole { ADMIN, USER, PUBLIC }

}

predicates {

  activeTeamMember: """
      team_id IN (
        SELECT team_id
        FROM team_member
        WHERE user_id = {{auth.user.id}}
          AND is_active = true
      )
    """

  ownUser: "id = {{auth.user.id}}"

}

models {

  model Announcement {
      id:      UUID @id @default(gen_random_uuid())
      teamId:  UUID
      message: TEXT

      team: Team @relation(
        fields: [teamId],
        references: [id],
        onDelete: CASCADE
      )

      @policy(
        role: USER,
        allow: [select, update, delete],
        where: """
          EXISTS (
            SELECT 1
            FROM team_member tm
            WHERE tm.team_id = announcement.team_id
              AND tm.user_id = {{auth.user.id}}
              AND tm.is_active = true
          )
        """
      )
      @policy(role: ADMIN, allow: all)
    }

  model Log {
      id:        UUID      @id @default(gen_random_uuid())
      message:   TEXT
      createdAt: TIMESTAMP @default(now())
    }

  model Note {
      id:     UUID         @id @default(gen_random_uuid())
      teamId: UUID
      title:  VARCHAR(255)
      body:   TEXT

      team: Team @relation(
        fields: [teamId],
        references: [id],
        onDelete: CASCADE
      )

      @policy(
        role: USER,
        allow: [select, insert, update, delete],
        where: activeTeamMember
      )
      @policy(role: ADMIN, allow: all)
    }

  model Order {
      id:          UUID        @id @default(gen_random_uuid())
      userId:      UUID
      status:      OrderStatus @default(PENDING)
      totalAmount: DECIMAL(10, 2)
      items:       JSONB
      createdAt:   TIMESTAMP   @default(now())
      updatedAt:   TIMESTAMP?

      user:        User        @relation(fields: [userId], references: [id])
      products:    ProductOrder[]

      @@index(fields: [userId])
      @@index(fields: [status, createdAt], name: "order_status_created_idx")
    }

  model Product {
      id:          UUID        @id @default(gen_random_uuid())
      name:        VARCHAR(255)
      description: TEXT
      price:       DECIMAL(10, 2)
      stock:       INTEGER
      category:    VARCHAR(100)
      tags:        TEXT[]
      metadata:    JSONB       @unfilterable
      createdAt:   TIMESTAMP   @default(now())
      updatedAt:   TIMESTAMP?

      orders:      ProductOrder[]

      @@trigger {
        timing: AFTER,
        event: UPDATE,
        level: ROW,
        execute: """
          IF (OLD.stock <> NEW.stock) THEN
            INSERT INTO Log (message) VALUES ('Product stock changed');
          END IF;
          RETURN NEW;
        """
      }

      @@trigger {
        timing: BEFORE,
        event: UPDATE,
        level: ROW,
        execute: """
          IF (OLD.price <> NEW.price) THEN
            INSERT INTO Log (message) VALUES ('Product price changed');
          END IF;
          RETURN NEW;
        """
      }
    }

  model ProductOrder {
      id:        SERIAL
      orderId:   UUID
      productId: UUID
      quantity:  INTEGER
      price:     DECIMAL(10, 2)

      order:     Order   @relation(fields: [orderId], references: [id])
      product:   Product @relation(fields: [productId], references: [id])

      @@id(fields: [orderId, productId])
    }

  model Profile {
      id:       UUID        @id @default(gen_random_uuid())
      userId:   UUID        @unique
      bio:      TEXT
      avatar:   VARCHAR(255)
      location: POINT

      user:     User        @relation(
        fields: [userId],
        references: [id],
        onDelete: CASCADE,
        onUpdate: SET_NULL
      )
    }

  model Team {
      id:      UUID         @id @default(gen_random_uuid())
      name:    VARCHAR(100)

      members: TeamMember[]
      notes:   Note[]
      announcements: Announcement[]

      @rest(false)
    }

  model TeamMember {
      id:       UUID    @id @default(gen_random_uuid())
      teamId:   UUID
      userId:   UUID
      isActive: BOOLEAN @default(true)

      team: Team @relation(
        fields: [teamId],
        references: [id],
        onDelete: CASCADE
      )
      user: User @relation(
        fields: [userId],
        references: [id],
        onDelete: CASCADE
      )

      @rest(false)
      @@index(fields: [userId, teamId])
    }

  model User {
      id:           UUID        @id @default(gen_random_uuid()) @unfilterable
      email:        VARCHAR(255) @unique @regex(pattern: "^[\\w.-]+@[\\w.-]+\\.\\w+$", message: "Invalid email address")
      name:         VARCHAR(150)
      role:         UserRole    @default(USER)
      age:          SMALLINT? @range(min: 1, max: 120, message: "Age must be between 1 and 120")
      balance:      INTEGER
      isActive:     BOOLEAN     @default(true)
      createdAt:    TIMESTAMP   @default(now())
      updatedAt:    TIMESTAMP?  @unfilterable
      passwordHash: VARCHAR(255)? @omit @unfilterable

      profile:     Profile?
      orders:      Order[]
      teamMembers: TeamMember[]

      @rest(except: [create, update, delete])
      @policy(role: USER, allow: [select], where: ownUser)
      @policy(role: ADMIN, allow: all)

      @@index(fields: [role, isActive])
      @@index(fields: [name], where: "isActive = true", name: "active_users_name_idx", type: BTREE)
      @@index(fields: [email], unique: true, where: "role = 'PUBLIC'")

      @@trigger {
        timing: BEFORE,
        event: UPDATE,
        level: ROW,
        execute: """
          IF (OLD.balance <> NEW.balance) THEN
            RAISE EXCEPTION 'Balance cannot be updated directly';
          END IF;
          RETURN NEW;
        """
      }
    }

}

functions {

  function getUserBalance(userId: UUID): INTEGER {
      language: sql
      volatility: STABLE
      execute: """
        SELECT balance FROM "user" WHERE id = user_id
      """
    }

  function searchProducts(query: TEXT): TABLE(id: UUID, name: TEXT, price: DECIMAL) {
      language: sql
      volatility: STABLE
      execute: """
        SELECT id, name, price FROM product
        WHERE name ILIKE '%' || query || '%'
      """
    }

}
